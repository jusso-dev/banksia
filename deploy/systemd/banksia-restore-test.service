[Unit]
Description=Banksia restore test and evidence pack
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=banksia
Group=banksia
WorkingDirectory=/var/lib/banksia
Environment=BANKSIA_CONFIG=/etc/banksia/banksia.toml
Environment=BANKSIA_OPERATOR=systemd-timer
# Exit code 3 means the restore test ran and failed. Alert on any non-zero exit.
ExecStart=/usr/local/bin/banksia restore-test run
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/banksia
